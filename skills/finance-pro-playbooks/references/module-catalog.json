  "merge_rules": {
    "boundary_rule": "Existing material processing (investment decision review, meeting minutes, opportunity screening) and new material production (Teaser, ECM dossier, research materials) are both handled by the corporate-finance plugin; distinguish at the task level: existing material processing should use deal-screening-scorecard / pre-ic-consistency-review / meeting-minutes (existing-material review), new material production should use the remaining tasks in the deal-materials group.",
    "notes": "Task-level patterns in references/corporate-finance/task-catalog.json select the specialist task, and requires_research_upstream adds equity-research when a research verb is present."
  },
